<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Normalizador de Tabelas</title>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        .preview-wrapper {
            overflow-x: auto;
            overflow-y: auto;
            max-width: 100%;
            max-height: 400px;
        }

        .preview-wrapper table {
            min-width: max-content;
        }

        .preview-wrapper th,
        .preview-wrapper td {
            white-space: nowrap;
        }
    </style>
</head>

<body class="bg-light">

    <div
        id="app"
        class="container min-vh-100 d-flex align-items-center justify-content-center"
    >

        <div
            class="card shadow-sm border-0"
            style="max-width: 900px; width: 100%;"
        >

            <div class="card-body p-5 text-center">

                <h1 class="h3 mb-2">
                    Padronizar tabela
                </h1>

                <p class="text-muted mb-4">
                    Envie sua planilha para começar a padronização.
                </p>

                <!-- Área de Upload -->
                <div
                    id="drop-area"
                    class="border border-2 border-secondary rounded-3 p-5"
                    style="border-style: dashed !important; cursor: pointer;"
                >

                    <div class="mb-3">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="48"
                            height="48"
                            fill="currentColor"
                            class="text-secondary"
                            viewBox="0 0 16 16"
                        >
                            <path
                                d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"
                            />
                            <path
                                d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V10.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z"
                            />
                        </svg>
                    </div>

                    <h2 class="h5">
                        Arraste sua planilha aqui
                    </h2>

                    <p class="text-muted mb-3">
                        ou clique para selecionar um arquivo
                    </p>

                    <input
                        type="file"
                        id="file-input"
                        class="d-none"
                        accept=".xls,.xlsx,.csv"
                        @change="selecionar_arquivo"
                    >

                    <label
                        for="file-input"
                        class="btn btn-outline-primary px-4"
                    >
                        Selecionar arquivo
                    </label>

                    <p class="small text-muted mt-3 mb-0">
                        Formatos aceitos: XLS, XLSX e CSV
                    </p>

                </div>

                <!-- Arquivo selecionado -->
                <div
                    v-if="arquivo_selecionado"
                    class="mt-4"
                >
                    <div
                        class="alert alert-secondary d-flex align-items-center justify-content-between mb-0"
                    >
                        <div class="text-start">
                            <strong>
                                {{ arquivo_selecionado.name }}
                            </strong>
                            <br>
                            <small class="text-muted">
                                {{ formatar_tamanho(arquivo_selecionado.size) }}
                            </small>
                        </div>

                        <button
                            type="button"
                            class="btn btn-outline-danger btn-sm"
                            @click="remover_arquivo"
                        >
                            <i class="bi bi-trash"></i>    
                            Remover
                        </button>
                    </div>
                </div>

                <!-- Prévia da tabela -->
                <div
                    v-if="dados_tabela.length > 0"
                    class="mt-4 text-start"
                >
                    <div class="card border">

                        <div class="card-header bg-white fw-semibold">
                            Prévia da tabela
                        </div>

                        <div class="card-body p-0">

                            <div class="preview-wrapper">

                                <table class="table table-striped table-hover table-sm mb-0">

                                    <thead>
                                        <tr>
                                            <th
                                                v-for="coluna in colunas_tabela"
                                                :key="coluna"
                                            >
                                                <div class="d-flex align-items-center justify-content-between gap-2">
                                                    <span>{{ coluna }}</span>
                                                    
                                                    <button
                                                        type="button"
                                                        class="btn btn-sm btn-light btn-menu-coluna"
                                                        @click.stop="apagar_coluna(coluna)"
                                                    >
                                                        <i class="bi bi-trash text-danger"></i>
                                                    </button>

                                                    <button
                                                        type="button"
                                                        class="btn btn-sm btn-light btn-menu-coluna"
                                                        @click.stop="abrir_menu_coluna(coluna, $event)"
                                                    >
                                                        <i class="bi bi-gear"></i>
                                                    </button>

                                                </div>
                                            </th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        <tr
                                            v-for="(linha, index) in dados_tabela"
                                            :key="index"
                                        >
                                            <td
                                                v-for="coluna in colunas_tabela"
                                                :key="coluna"
                                            >
                                                {{ linha[coluna] }}
                                            </td>
                                        </tr>
                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                    <small class="text-muted">
                        Exibindo as primeiras {{ dados_tabela.length }} linhas.
                    </small>
                    
                    <div class="mt-4 text-start">
                        <button @click="baixar_tabela_padronizada" class="btn btn-outline-success">
                            <i class="bi bi-download"></i> Baixar Tabela Padronizada
                        </button>
                    </div>
                    
                </div>

            </div>

        </div>

        <!-- Menu fora da tabela -->
        <teleport to="body">
            <div
                v-if="menu_coluna_aberto"
                class="dropdown-menu show"
                :style="{
                    position: 'absolute',
                    top: menu_posicao.top + 'px',
                    left: menu_posicao.left + 'px',
                    zIndex: 9999
                }"
            >
                <template v-for="(operacoes, tipo) in operacoes_colunas" :key="tipo">
                    <h6 class="dropdown-header">{{ tipo }}</h6>

                    <button
                        v-for="operacao in operacoes"
                        :key="operacao"
                        type="button"
                        class="dropdown-item"
                        @click="executar_operacao(menu_coluna_aberto, operacao)"
                    >
                        {{ operacao }}
                    </button>
                </template>
            </div>
        </teleport>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <script type="module" src="/js/tabela.js"></script>

</body>

</html>