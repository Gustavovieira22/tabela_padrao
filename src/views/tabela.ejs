<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FRANK · Normalizador de Tabelas</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/tabela.css">
</head>

<body class="app-body">

    <header class="app-header">
        <div class="app-header__inner">
            <div class="brand">
                <span class="brand__mark">
                    <i class="bi bi-grid-1x2-fill"></i>
                </span>

                <span class="brand__text">
                    <span class="brand__name">FRANK</span>
                    <span class="brand__tag">Normalizador de Tabelas</span>
                </span>
            </div>

            <span class="header-pill">
                <i class="bi bi-shield-lock"></i>
                Processamento local, sem envio de arquivos
            </span>
        </div>
    </header>

    <main id="app" class="app-main">

        <section class="page-head">
            <p class="eyebrow">Padronização de dados</p>

            <h1 class="page-title">
                Padronize sua planilha em poucos cliques
            </h1>

            <p class="page-sub">
                Envie um arquivo XLS, XLSX ou CSV e ajuste nomes, CPFs e telefones
                direto na prévia dos dados.
            </p>
        </section>

        <div class="workspace-grid">

            <!-- Área de upload -->
            <section class="panel upload-panel">
                <div class="panel__head">
                    <h2 class="panel__title">
                        <span class="panel__step">1</span>
                        Envie sua planilha
                    </h2>
                </div>

                <div
                    id="drop-area"
                    class="dropzone"
                    :class="{ 'dropzone--compact': arquivo_selecionado }"
                >
                    <div class="dropzone__icon">
                        <i class="bi bi-cloud-arrow-up"></i>
                    </div>

                    <div class="dropzone__text">
                        <p class="dropzone__title">
                            {{ arquivo_selecionado ? 'Escolher outro arquivo' : 'Arraste sua planilha aqui' }}
                        </p>

                        <p class="dropzone__hint">
                            {{ arquivo_selecionado
                                ? 'arraste outro arquivo ou use o botão ao lado'
                                : 'ou clique para selecionar um arquivo' }}
                        </p>
                    </div>

                    <input
                        type="file"
                        id="file-input"
                        class="d-none"
                        accept=".xls,.xlsx,.csv"
                        @change="selecionar_arquivo"
                    >

                    <label for="file-input" class="btn-brand">
                        <i class="bi bi-folder2-open"></i>
                        Selecionar arquivo
                    </label>

                    <p class="dropzone__formats">
                        XLS · XLSX · CSV
                    </p>
                </div>

                <!-- Arquivo selecionado -->
                <div v-if="arquivo_selecionado" class="file-chip">
                    <span class="file-chip__icon">
                        <i class="bi bi-file-earmark-spreadsheet"></i>
                    </span>

                    <div class="file-chip__info">
                        <span class="file-chip__name" :title="arquivo_selecionado.name">
                            {{ arquivo_selecionado.name }}
                        </span>

                        <span class="file-chip__size">
                            {{ formatar_tamanho(arquivo_selecionado.size) }}
                        </span>
                    </div>

                    <div class="file-chip__action">
                        <button
                            type="button"
                            class="btn-ghost"
                            @click="remover_arquivo"
                        >
                            <i class="bi bi-trash3"></i>
                            Remover
                        </button>
                    </div>
                </div>

                <!-- Abas da planilha -->
                <div
                    v-if="arquivo_selecionado && abas_disponiveis.length > 1"
                    class="sheet-box"
                >
                    <label class="sheet-box__label" for="sheet-select">
                        <i class="bi bi-layers"></i>
                        Aba da planilha
                    </label>

                    <select
                        id="sheet-select"
                        v-model="aba_selecionada"
                        @change="trocar_aba"
                    >
                        <option
                            v-for="aba in abas_disponiveis"
                            :key="aba"
                            :value="aba"
                        >
                            {{ aba }}
                        </option>
                    </select>

                    <span class="sheet-box__hint">
                        {{ abas_disponiveis.length }} abas encontradas · a troca
                        recarrega os dados originais da aba
                    </span>
                </div>

            </section>

            <!-- Guia -->
            <aside class="panel">
                <div class="panel__head">
                    <h2 class="panel__title">
                        <span class="panel__step">
                            <i class="bi bi-signpost-split"></i>
                        </span>
                        Como funciona
                    </h2>
                </div>

                <ol class="steps">
                    <li class="step">
                        <span class="step__num">1</span>

                        <div class="step__body">
                            <strong>Importe o arquivo</strong>
                            <span>
                                Arraste a planilha ou use o botão. A aba
                                principal do arquivo é carregada
                                automaticamente; se houver outras, use o
                                seletor para alternar.
                            </span>
                        </div>
                    </li>

                    <li class="step">
                        <span class="step__num">2</span>

                        <div class="step__body">
                            <strong>Trate as colunas</strong>
                            <span>
                                No cabeçalho da tabela, use a engrenagem para
                                renomear, limpar CPF, padronizar telefones ou
                                unir duas colunas em uma só.
                            </span>
                        </div>
                    </li>

                    <li class="step">
                        <span class="step__num">3</span>

                        <div class="step__body">
                            <strong>Baixe o resultado</strong>
                            <span>
                                Escolha o formato (CSV, XLSX, XLS ou ODS) e
                                exporte a versão padronizada, pronta para
                                importar no seu sistema. Valores que não
                                puderam ser padronizados saem da planilha e
                                são listados na aba Erros, com o valor
                                original.
                            </span>
                        </div>
                    </li>
                </ol>

                <div class="note">
                    <i class="bi bi-info-circle"></i>
                    <span>
                        A prévia é paginada, mas as operações são aplicadas
                        em todas as linhas da aba selecionada.
                    </span>
                </div>

                <div class="note">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>
                        Errou um ajuste? Use Desfazer (ou Ctrl+Z) para voltar
                        ao estado anterior, um passo por vez.
                    </span>
                </div>
            </aside>

        </div>

        <!-- Prévia da tabela -->
        <section v-if="dados_tabela.length > 0" class="panel preview-panel">

            <header class="preview-panel__head">
                <h2 class="preview-panel__title">
                    <i class="bi bi-table"></i>
                    Prévia da tabela
                </h2>

                <div class="preview-tools">
                    <div class="stat-row">
                        <span
                            v-if="abas_disponiveis.length > 1"
                            class="stat"
                            :title="'Aba: ' + aba_selecionada"
                        >
                            <i class="bi bi-layers"></i>
                            <span class="stat__text">{{ aba_selecionada }}</span>
                        </span>

                        <span class="stat">
                            <i class="bi bi-columns-gap"></i>
                            {{ colunas_tabela.length }} colunas
                        </span>

                        <span class="stat stat--muted">
                            <i class="bi bi-list-ol"></i>
                            {{ total_linhas }} linhas
                        </span>

                        <span
                            v-if="total_erros > 0"
                            class="stat stat--alerta"
                            title="Valores que não puderam ser padronizados. Eles saem da tabela e são listados na aba Erros do arquivo baixado, com o valor original."
                        >
                            <i class="bi bi-exclamation-triangle"></i>
                            {{ total_erros }}
                            {{ total_erros === 1 ? 'valor não padronizado' : 'valores não padronizados' }}
                        </span>
                    </div>

                    <button
                        type="button"
                        class="btn-ghost btn-undo"
                        :disabled="!pode_desfazer"
                        :title="pode_desfazer
                            ? 'Desfazer: ' + ultima_alteracao + ' (Ctrl+Z)'
                            : 'Nenhuma alteração para desfazer'"
                        @click="desfazer_alteracao"
                    >
                        <i class="bi bi-arrow-counterclockwise"></i>
                        Desfazer
                        <span v-if="historico.length > 1" class="btn-undo__count">
                            {{ historico.length }}
                        </span>
                    </button>
                </div>
            </header>

            <div class="preview-panel__body">
                <div class="preview-wrapper">

                    <table class="data-table">

                        <thead>
                            <tr>
                                <th
                                    v-for="coluna in colunas_tabela"
                                    :key="coluna"
                                >
                                    <div class="col-head">
                                        <div
                                            v-if="coluna_em_edicao === coluna"
                                            class="col-head__edit"
                                        >
                                            <input
                                                class="col-head__input"
                                                :class="{ 'col-head__input--erro': erro_renomear }"
                                                data-renomear-input
                                                type="text"
                                                autocomplete="off"
                                                spellcheck="false"
                                                :value="nome_em_edicao"
                                                :aria-label="`Novo nome para a coluna ${coluna}`"
                                                :aria-invalid="erro_renomear ? 'true' : 'false'"
                                                @input="digitou_nome_coluna"
                                                @keydown.enter.prevent="confirmar_renomear_coluna"
                                                @keydown.escape.prevent="cancelar_renomear_coluna"
                                                @blur="sair_do_campo_renomear"
                                            >

                                            <span
                                                v-if="erro_renomear"
                                                class="col-head__erro"
                                                role="alert"
                                            >
                                                {{ erro_renomear }}
                                            </span>

                                            <span v-else class="col-head__dica">
                                                Enter salva · Esc cancela
                                            </span>
                                        </div>

                                        <span
                                            v-else
                                            class="col-head__name"
                                            :title="`${coluna} — clique duas vezes para renomear`"
                                            @dblclick.stop="iniciar_renomear_coluna(coluna)"
                                        >
                                            {{ coluna }}
                                        </span>

                                        <span class="col-head__actions">
                                            <button
                                                type="button"
                                                class="icon-btn icon-btn--danger btn-menu-coluna"
                                                title="Apagar coluna"
                                                @click.stop="apagar_coluna(coluna)"
                                            >
                                                <i class="bi bi-trash3"></i>
                                            </button>

                                            <button
                                                type="button"
                                                class="icon-btn btn-menu-coluna"
                                                title="Operações da coluna"
                                                @click.stop="abrir_menu_coluna(coluna, $event)"
                                            >
                                                <i class="bi bi-sliders2"></i>
                                            </button>
                                        </span>
                                    </div>
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr
                                v-for="(linha, index) in dados_tabela"
                                :key="index"
                            >
                                <td
                                    v-for="coluna in colunas_tabela"
                                    :key="coluna"
                                    :title="linha[coluna]"
                                >
                                    {{ linha[coluna] }}
                                </td>
                            </tr>
                        </tbody>

                    </table>

                </div>
            </div>

            <footer class="preview-panel__foot">
                <div class="pagination">
                    <p class="pagination__info">
                        <i class="bi bi-info-circle"></i>
                        Exibindo
                        <strong>{{ inicio_exibicao }}–{{ fim_exibicao }}</strong>
                        de
                        <strong>{{ total_linhas }}</strong>
                        linhas
                    </p>

                    <div class="pagination__tools">
                        <label class="pagination__size">
                            Linhas por página
                            <select v-model.number="linhas_por_pagina">
                                <option
                                    v-for="opcao in opcoes_linhas_por_pagina"
                                    :key="opcao"
                                    :value="opcao"
                                >
                                    {{ opcao === 0 ? 'Todas' : opcao }}
                                </option>
                            </select>
                        </label>

                        <nav
                            v-if="total_paginas > 1"
                            class="pagination__nav"
                            aria-label="Paginação da tabela"
                        >
                            <button
                                type="button"
                                class="pagination__btn"
                                :disabled="pagina_atual === 1"
                                title="Página anterior"
                                @click="pagina_anterior"
                            >
                                <i class="bi bi-chevron-left"></i>
                            </button>

                            <template v-for="(pagina, indice) in paginas_visiveis" :key="indice">
                                <span
                                    v-if="pagina === '...'"
                                    class="pagination__ellipsis"
                                >
                                    …
                                </span>

                                <button
                                    v-else
                                    type="button"
                                    class="pagination__btn"
                                    :class="{ 'pagination__btn--active': pagina === pagina_atual }"
                                    :title="'Página ' + pagina"
                                    @click="ir_para_pagina(pagina)"
                                >
                                    {{ pagina }}
                                </button>
                            </template>

                            <button
                                type="button"
                                class="pagination__btn"
                                :disabled="pagina_atual === total_paginas"
                                title="Próxima página"
                                @click="proxima_pagina"
                            >
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </nav>
                    </div>
                </div>

                <div class="download-box">
                    <p v-if="aviso_formato_download" class="download-box__aviso">
                        <i class="bi bi-exclamation-triangle"></i>
                        <span>{{ aviso_formato_download }}</span>
                    </p>

                    <label class="download-box__format">
                        Formato
                        <select v-model="formato_download">
                            <option
                                v-for="formato in formatos_download"
                                :key="formato.valor"
                                :value="formato.valor"
                            >
                                {{ formato.rotulo }}
                            </option>
                        </select>
                    </label>

                    <button
                        type="button"
                        class="btn-brand btn-brand--success"
                        @click="baixar_tabela_padronizada"
                    >
                        <i class="bi bi-download"></i>
                        Baixar tabela padronizada
                    </button>
                </div>
            </footer>

        </section>

        <!-- Menu de operações da coluna (fora da tabela) -->
        <teleport to="body">
            <div
                v-if="menu_coluna_aberto"
                ref="menu_coluna"
                class="dropdown-menu show column-menu"
                :style="{
                    position: 'absolute',
                    top: menu_posicao.top + 'px',
                    left: menu_posicao.left + 'px',
                    zIndex: 9999
                }"
            >
                <div class="column-menu__title">
                    <i class="bi bi-sliders2"></i>
                    {{ menu_coluna_aberto }}
                </div>

                <template v-for="(operacoes, tipo) in operacoes_colunas" :key="tipo">
                    <h6 class="dropdown-header">{{ tipo }}</h6>

                    <button
                        v-for="operacao in operacoes"
                        :key="operacao"
                        type="button"
                        class="dropdown-item"
                        @click="executar_operacao(menu_coluna_aberto, operacao)"
                    >
                        <span class="col-menu-item">
                            <span class="col-menu-item__label">
                                {{ rotulos_operacoes[operacao] || operacao }}
                            </span>

                            <span
                                v-if="dicas_operacoes[operacao]"
                                class="col-menu-item__hint"
                            >
                                {{ dicas_operacoes[operacao] }}
                            </span>
                        </span>
                    </button>
                </template>
            </div>
        </teleport>

        <!-- Seletor da segunda coluna para unir (concatenação sem espaço) -->
        <teleport to="body">
            <div
                v-if="unir_colunas_origem"
                class="merge-overlay"
                @click.self="fechar_unir_colunas"
            >
                <div
                    class="merge-modal"
                    role="dialog"
                    aria-modal="true"
                    aria-labelledby="merge-modal-title"
                >
                    <header class="merge-modal__head">
                        <h2 id="merge-modal-title" class="merge-modal__title">
                            <i class="bi bi-link-45deg"></i>
                            Unir colunas
                        </h2>

                        <button
                            type="button"
                            class="icon-btn"
                            title="Fechar (Esc)"
                            @click="fechar_unir_colunas"
                        >
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </header>

                    <div class="merge-modal__body">
                        <p class="merge-modal__intro">
                            Escolha a coluna que será concatenada com
                            <strong>{{ unir_colunas_origem }}</strong>.
                            Os valores são juntados linha por linha, sem espaço
                            entre eles, e o resultado fica em
                            <strong>{{ unir_colunas_origem }}</strong>.
                            A coluna escolhida é removida depois da união.
                        </p>

                        <label class="merge-modal__label" for="merge-target">
                            Concatenar com a coluna
                        </label>

                        <select
                            id="merge-target"
                            v-model="unir_colunas_destino"
                            class="merge-modal__select"
                        >
                            <option value="">Selecione uma coluna…</option>

                            <option
                                v-for="coluna in colunas_para_unir"
                                :key="coluna"
                                :value="coluna"
                            >
                                {{ coluna }}
                            </option>
                        </select>

                        <div v-if="unir_colunas_destino" class="merge-preview">
                            <span class="merge-preview__label">
                                Prévia da primeira linha preenchida
                            </span>

                            <p v-if="exemplo_uniao" class="merge-preview__row">
                                <span class="merge-preview__part">
                                    {{ exemplo_uniao.origem || '—' }}
                                </span>

                                <span class="merge-preview__plus">+</span>

                                <span class="merge-preview__part">
                                    {{ exemplo_uniao.destino || '—' }}
                                </span>

                                <i class="bi bi-arrow-right"></i>

                                <strong class="merge-preview__result">
                                    {{ exemplo_uniao.resultado || '—' }}
                                </strong>
                            </p>

                            <p v-else class="merge-preview__row merge-preview__row--empty">
                                As duas colunas estão vazias nas linhas disponíveis.
                            </p>
                        </div>
                    </div>

                    <footer class="merge-modal__foot">
                        <button
                            type="button"
                            class="btn-ghost"
                            @click="fechar_unir_colunas"
                        >
                            Cancelar
                        </button>

                        <button
                            type="button"
                            class="btn-brand"
                            :disabled="!unir_colunas_destino"
                            @click="confirmar_unir_colunas"
                        >
                            <i class="bi bi-link-45deg"></i>
                            Unir colunas
                        </button>
                    </footer>
                </div>
            </div>
        </teleport>

    </main>

    <footer class="app-footer">
        <div class="app-footer__inner">
            <span>
                <i class="bi bi-grid-1x2-fill"></i>
                FRANK · Normalizador de Tabelas
            </span>

            <span>
                Seus arquivos não saem deste navegador.
            </span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <script type="module" src="/js/tabela.js"></script>

</body>

</html>

